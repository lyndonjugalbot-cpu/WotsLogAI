{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: app commands and event listening only. No filesystem, shell, HTTP or dialog access from the webview.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-select-log",
    "allow-load-demo",
    "allow-scan-log",
    "allow-cancel-scan",
    "allow-query-logs",
    "allow-prepare-analysis",
    "allow-analyze-error",
    "allow-demo-analysis",
    "allow-save-ai-settings",
    "allow-get-ai-settings"
  ]
}
